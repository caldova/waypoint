FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<deployment-name>

# FoundryIQ only. Castia resolves the platform endpoint from TOOLBOX_NAME.
TOOLBOX_NAME=contract-toolbox
TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT=https://<project>/toolboxes/contract-toolbox/mcp?api-version=v1
