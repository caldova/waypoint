# Foundry project endpoint.
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
# Auto-injected by the hosted runtime; set this manually for local dev.
FOUNDRY_PROJECT_ENDPOINT=""

# Name of a model deployment that exists in your Foundry project.
# The `caldova-agents` default is `gpt-6-astra` (configurable via the
# modelDeploymentName / modelName bicep params or AZURE_AI_MODEL_DEPLOYMENT_NAME
# / MODEL_NAME azd env vars).
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-6-astra"

# Optional: enables OpenTelemetry traces for local dev.
# Auto-injected in the hosted runtime.
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Optional: read-only Waypoint API integration testing for Assurance Orchestrator.
# Use the direct API base URL, or the web proxy base ending in /api for
# same-origin parity. Leave the scope empty for local Aspire loopback dev auth;
# set it to the delegated Waypoint API scope for deployed/MSAL-enabled testing.
# WAYPOINT_API_BASE_URL=
# WAYPOINT_API_SCOPE=

# contract-agent / contract-policy-expert FoundryIQ toolbox. Castia resolves
# TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT from TOOLBOX_NAME.
TOOLBOX_NAME="contract-toolbox"
TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT=""
TOOLBOX_WORKIQ_MCP_ENDPOINT=""
TOOLBOX_WORKIQ_PROJECT_CONNECTION_ID=""
TOOLBOX_WEBIQ_MCP_ENDPOINT=""
TOOLBOX_FABRICIQ_MCP_ENDPOINT=""

# operations-data-expert (FabricIQ) live grounding. Name of the MicrosoftFabric
# project connection that targets the Waypoint Fabric data agent
# (WaypointDataAgent). Provisioned by scripts/initialize_fabric_data_agent.py.
# The Fabric data agent tool uses on-behalf-of (OBO) user identity, so live
# grounding requires an interactive/user-context surface.
FABRIC_DATA_AGENT_CONNECTION_NAME="waypoint-data-agent-connection"

# operations-data-expert headless FabricIQ path. Deterministic direct read of
# the mirrored operational core over the Fabric SQL analytics endpoint using the
# Forge project managed identity (token audience https://database.windows.net/).
# Server host + database of the mirrored DB; schema defaults to `public`.
# Only suppliers/invoices/invoice_lines/reconciliation_findings are read.
FABRIC_MIRRORED_SQL_ENDPOINT=""
FABRIC_MIRRORED_DATABASE=""
FABRIC_MIRRORED_SCHEMA="public"

# Collaboration Evidence Expert WorkIQ toolbox. The toolbox is backed by
# UserEntraToken RemoteTool connections named WorkIQCopilot, WorkIQTeams, and
# WorkIQSharePoint, so WorkIQ calls run as the current signed-in user.
WORKIQ_TOOLBOX_NAME="collaboration-evidence-tools"
WORKIQ_TOOLBOX_MCP_ENDPOINT=""
