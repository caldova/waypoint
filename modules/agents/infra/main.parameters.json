{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "resourceGroupName": {
        "value": "${AZURE_RESOURCE_GROUP}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      },
      "aiFoundryResourceName": {
        "value": "${AZURE_AI_ACCOUNT_NAME}"
      },
      "aiFoundryProjectName": {
        "value": "${AZURE_AI_PROJECT_NAME}"
      },
      "aiDeploymentsLocation": {
        "value": "${AZURE_LOCATION}"
      },
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "principalType": {
        "value": "${AZURE_PRINCIPAL_TYPE}"
      },
      "additionalAdminsJson": {
        "value": "${ADDITIONAL_ADMINS=[]}"
      },
      "aiProjectDeploymentsJson": {
        "value": "${AI_PROJECT_DEPLOYMENTS=[]}"
      },
      "modelDeploymentName": {
        "value": "${AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.5}"
      },
      "modelName": {
        "value": "${MODEL_NAME=gpt-5.5}"
      },
      "modelVersion": {
        "value": "${MODEL_VERSION=2026-04-24}"
      },
      "modelFormat": {
        "value": "${MODEL_FORMAT=OpenAI}"
      },
      "modelSkuName": {
        "value": "${MODEL_SKU_NAME=GlobalStandard}"
      },
      "modelCapacity": {
        "value": "${MODEL_CAPACITY=200}"
      },
      "embeddingDeploymentName": {
        "value": "${AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large}"
      },
      "embeddingModelName": {
        "value": "${EMBEDDING_MODEL_NAME=text-embedding-3-large}"
      },
      "embeddingModelVersion": {
        "value": "${EMBEDDING_MODEL_VERSION=1}"
      },
      "embeddingModelSkuName": {
        "value": "${EMBEDDING_MODEL_SKU_NAME=Standard}"
      },
      "embeddingModelCapacity": {
        "value": "${EMBEDDING_MODEL_CAPACITY=50}"
      },
      "aiProjectConnectionsJson": {
        "value": "${AI_PROJECT_CONNECTIONS=[]}"
      },
      "aiProjectConnectionCredentialsJson": {
        "value": "${AI_PROJECT_CONNECTION_CREDENTIALS}"
      },
      "aiProjectDependentResourcesJson": {
        "value": "${AI_PROJECT_DEPENDENT_RESOURCES=[]}"
      },
      "workiqEmailMcpServerUrl": {
        "value": "${WORKIQ_EMAIL_MCP_SERVER_URL=}"
      },
      "workiqTeamsMcpServerUrl": {
        "value": "${WORKIQ_TEAMS_MCP_SERVER_URL=}"
      },
      "workiqSharepointMcpServerUrl": {
        "value": "${WORKIQ_SHAREPOINT_MCP_SERVER_URL=}"
      },
      "workiqMcpServerUrl": {
        "value": "${WORKIQ_MCP_SERVER_URL=}"
      },
      "enableWorkiqConnections": {
        "value": "${ENABLE_WORKIQ_CONNECTIONS=true}"
      },
      "enableMonitoring": {
        "value": "${ENABLE_MONITORING=true}"
      },
      "enableHostedAgents": {
        "value": "${ENABLE_HOSTED_AGENTS=false}"
      },
      "enableCapabilityHost": {
        "value": "${ENABLE_CAPABILITY_HOST=true}"
      },
      "enableSearch": {
        "value": "${ENABLE_SEARCH=true}"
      },
      "useExistingAiProject": {
        "value": "${USE_EXISTING_AI_PROJECT=false}"
      },
      "existingContainerRegistryResourceId": {
        "value": "${AZURE_CONTAINER_REGISTRY_RESOURCE_ID=}"
      },
      "existingContainerRegistryEndpoint": {
        "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT=}"
      },
      "existingAcrConnectionName": {
        "value": "${AZURE_AI_PROJECT_ACR_CONNECTION_NAME=}"
      },
      "existingApplicationInsightsConnectionString": {
        "value": "${APPLICATIONINSIGHTS_CONNECTION_STRING=}"
      },
      "existingApplicationInsightsResourceId": {
        "value": "${APPLICATIONINSIGHTS_RESOURCE_ID=}"
      },
      "existingAppInsightsConnectionName": {
        "value": "${APPLICATIONINSIGHTS_CONNECTION_NAME=}"
      }
    }
}
