# Foundry project + model
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-6-astra

# Optional Content Understanding extraction. If CONTENT_UNDERSTANDING_ENDPOINT is
# empty, local runs use deterministic PDF text extraction. Set the endpoint (or
# CONTENT_UNDERSTANDING_USE_FOUNDRY_PROJECT=true) to call the live service.
CONTENT_UNDERSTANDING_ENDPOINT=
CONTENT_UNDERSTANDING_USE_FOUNDRY_PROJECT=false
CONTENT_UNDERSTANDING_API_VERSION=2025-11-01
CONTENT_UNDERSTANDING_ANALYZER_ID=prebuilt-contract
CONTENT_UNDERSTANDING_COMPLETION_DEPLOYMENT=gpt-5.5
CONTENT_UNDERSTANDING_EMBEDDING_DEPLOYMENT=text-embedding-3-large
CONTENT_UNDERSTANDING_MODEL_DEPLOYMENTS_JSON=
CONTENT_UNDERSTANDING_SCOPE=https://cognitiveservices.azure.com/.default
CONTENT_UNDERSTANDING_API_KEY=
CONTENT_UNDERSTANDING_TIMEOUT_SECONDS=120
CONTENT_UNDERSTANDING_POLL_INTERVAL_SECONDS=2
CONTENT_UNDERSTANDING_MAX_POLLS=60

# Optional: future Waypoint Contracts API surface.
WAYPOINT_API_BASE_URL=
WAYPOINT_API_SCOPE=
WAYPOINT_API_KEY=
WAYPOINT_API_VERIFY_SSL=true
CONTRACTS_DEV_USER_EMAIL=local.user@contracts.local

# Optional: future shared mailbox identity for routine-driven polling.
CONTRACTS_INBOX_ADDRESS=contracts@contoso.com
CONTRACTS_DOCUMENT_SOURCE_MODE=auto
CONTRACTS_LOCAL_DOCUMENT_KIND=contract
CONTRACTS_LOCAL_PDF_PATH=
CONTRACTS_LOCAL_INVOICE_PDF_PATH=
CONTRACTS_AGENT_BUILD_ID=local-dev
CONTRACTS_AGENT_DEPLOYMENT_STAGE=local
CONTRACTS_LOG_LEVEL=INFO

# Optional: agent-owned SharePoint report publishing. When drive/folder ids are
# set, draft_contract_report uploads the generated DOCX to that folder and
# creates an organization view link for Teams. Without these, local runs keep a
# file:// DOCX URL only.
CONTRACTS_REPORTS_PUBLISH_MODE=auto
CONTRACTS_REPORTS_DRIVE_ID=
CONTRACTS_REPORTS_FOLDER_ITEM_ID=
CONTRACTS_REPORTS_SCOPE=https://graph.microsoft.com/.default
CONTRACTS_REPORTS_LINK_TYPE=view
CONTRACTS_REPORTS_LINK_SCOPE=organization
CONTRACTS_REPORTS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Optional: server-side FoundryIQ toolbox. Castia resolves the MCP endpoint from
# TOOLBOX_NAME when the hosted project exposes the contract-toolbox toolbox.
TOOLBOX_NAME=contract-toolbox
TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT=

# Local scaffold mode is enabled automatically when WAYPOINT_API_BASE_URL is not
# set. Set false to force future-API placeholder responses instead.
CONTRACTS_LOCAL_FIXTURE_MODE=true
CONTRACTS_LOCAL_STATE_DIR=
