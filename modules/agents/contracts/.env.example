# Foundry project + model
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-6-astra

# Optional: future Waypoint Contracts API surface.
WAYPOINT_API_BASE_URL=
WAYPOINT_API_SCOPE=
WAYPOINT_API_KEY=
WAYPOINT_API_VERIFY_SSL=true

# Optional: future shared mailbox identity for routine-driven polling.
CONTRACTS_INBOX_ADDRESS=contracts@contoso.com

# Local scaffold mode is enabled automatically when WAYPOINT_API_BASE_URL is not
# set. Set false to force future-API placeholder responses instead.
CONTRACTS_LOCAL_FIXTURE_MODE=true
CONTRACTS_LOCAL_STATE_DIR=
