# Foundry project + model (required)
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-6-astra

# Optional: switch onto a reasoning / RFT-tuned deployment with no code change.
# MODEL_REASONING_EFFORT=medium

# Optional: record prompt/response text onto GenAI spans so traces are evaluable.
# AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true

# ── Server-side FoundryIQ toolbox ─────────────────────────────────────────────
# Castia resolves TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT from TOOLBOX_NAME, then
# builds the MCP spec for the contract/policy knowledge-base tool.
TOOLBOX_NAME=contract-toolbox
TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT=https://<project>/toolboxes/contract-toolbox/mcp?api-version=v1
