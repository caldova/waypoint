# Foundry project + model (required)
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.5

# Optional: switch onto a reasoning / RFT-tuned deployment with no code change.
# MODEL_REASONING_EFFORT=medium

# Optional: record prompt/response text onto GenAI spans so traces are evaluable.
# AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true

# ── Server-side toolbox lanes (investigative / retrieval) ─────────────────────
# Every retrieval capability reaches the agent as a server-side MCP toolbox tool
# (toolbox.py). Lanes are DISCOVERED from the environment — provision a toolbox,
# set its endpoint var, and the agent offers it with no code change.
#
# FoundryIQ (the live contract/policy KB, knowledge_base_retrieve) — the default
# lane, via castia's resolver. Set a full URL, or TOOLBOX_NAME to compose one from
# FOUNDRY_PROJECT_ENDPOINT. Read-only default allow-list is knowledge_base_retrieve.
# TOOLBOX_NAME=contracts-kb
# TOOLBOX_MCP_ENDPOINT=
# TOOLBOX_ALLOWED_TOOLS=knowledge_base_retrieve   # or a comma list, or * for all

# Additional lanes — one TOOLBOX_<NAME>_MCP_ENDPOINT each (the azd toolbox
# extension writes these). No connection => container managed identity, offered on
# every surface (headless-safe). Add TOOLBOX_<NAME>_PROJECT_CONNECTION_ID (e.g. a
# WorkIQ UserEntraToken connection) => runs as the signed-in user, Activity-only;
# add TOOLBOX_<NAME>_HEADLESS=1 to opt an app-only connection back onto headless.
# TOOLBOX_WEBIQ_MCP_ENDPOINT=
# TOOLBOX_WORKIQ_MCP_ENDPOINT=
# TOOLBOX_WORKIQ_PROJECT_CONNECTION_ID=
# TOOLBOX_WORKIQ_ALLOWED_TOOLS=*
